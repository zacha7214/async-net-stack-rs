[Unit]
Description=UDP lab DHCP client (%i)
Requires=async-net-lab@%i.service
After=async-net-lab@%i.service
PartOf=async-net-lab@%i.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/async-net-stack-rs
ExecStart=/usr/bin/python3 /opt/async-net-stack-rs/scripts/udp-system-lab.py dhcp-client --name %i
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
